# Copy to .env, then fill every required secret and digest from the approved
# deployment inventory. Digest values must use the sha256:<64 hex> OCI form.
DOCLING_API_KEY=
GROBID_API_KEY=
REDIS_PASSWORD=

DOCLING_IMAGE_DIGEST=
GROBID_BASE_DIGEST=
GROBID_IMAGE_DIGEST=
OCRMYPDF_IMAGE_DIGEST=
REDIS_IMAGE_DIGEST=
CADDY_IMAGE_DIGEST=

DOCUMENT_PROCESSING_PLATFORM=linux/amd64
GROBID_IMAGE_REPOSITORY=deepcritical/grobid
DOCLING_PORT=5001
GROBID_PORT=8070
