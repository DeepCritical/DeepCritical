# ============================================================================
# DeepCritical Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual API keys:
#   cp .env.example .env
#
# DO NOT commit .env to version control (it's already in .gitignore)
#
# Usage:
#   Option 1: Export manually: export ANTHROPIC_API_KEY="..." && uv run deepresearch
#   Option 2: Add to ~/.bashrc or ~/.zshrc for permanent setup
#   Option 3: Use python-dotenv (planned enhancement - see PR discussion)
# ============================================================================

# ============================================================================
# LLM API Keys (REQUIRED for core functionality)
# ============================================================================

# REQUIRED: Anthropic Claude API (default model for DeepCritical)
# Get your API key from: https://console.anthropic.com/
# Used by: pydantic-ai agents (auto-detected via ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=

# OPTIONAL: OpenAI API (alternative LLM, used for embeddings & optional flows)
# Get your API key from: https://platform.openai.com/api-keys
# Used in: configs/rag/llm/openai.yaml, configs/rag/embeddings/openai.yaml
OPENAI_API_KEY=

# ============================================================================
# Web Search API Keys (REQUIRED for DeepSearch flow)
# ============================================================================

# REQUIRED for DeepSearch flow: Serper API for web search
# Get your API key from: https://serper.dev/
# Used in: DeepResearch/src/tools/websearch_cleaned.py:21
SERPER_API_KEY=

# ============================================================================
# Execution Environment Configuration (Optional)
# ============================================================================

# Control whether to use Docker for code execution sandbox
# Used in: DeepResearch/src/utils/code_utils.py:229
# Options: "True" (default), "False", "None"
# Set to "False" if you don't have Docker installed or want to run code directly
DEEP_CRITICAL_USE_DOCKER=True

# ============================================================================
# Custom LLM Endpoint Configuration (Advanced - Optional)
# ============================================================================
# Use these ONLY if you're running a local model server (vLLM, llama.cpp, TGI)
# instead of using Anthropic/OpenAI cloud APIs.
#
# Leave commented out if using cloud APIs.

# Base URL for your local LLM server
# Used in: DeepResearch/src/models/openai_compatible_model.py:86
# LLM_BASE_URL=http://localhost:8000/v1

# API key for custom endpoint (use "EMPTY" for vLLM without auth, or actual key)
# Used in: DeepResearch/src/models/openai_compatible_model.py:102
# LLM_API_KEY=

# ============================================================================
# Database Configuration (Optional - for bioinformatics & RAG workflows)
# ============================================================================
# Neo4j graph database configuration
# NOTE: These env vars are NOT currently read by the app (hardcoded in configs/db/neo4j.yaml)
# This is a known limitation. Future PR will make Neo4j config use ${oc.env:...} pattern
#
# To use Neo4j, first install it:
#   docker run -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:latest
#
# Then configure these (when env var support is added):
# NEO4J_URI=neo4j://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
# NEO4J_DATABASE=neo4j

# ============================================================================
# Analytics Configuration (Optional)
# ============================================================================
# Directory for analytics data storage
# Used in: DeepResearch/src/utils/analytics.py:14
# ANALYTICS_DATA_DIR=./analytics_data

# ============================================================================
# Testing & Development (Optional - for contributors)
# ============================================================================
# These are primarily for CI/CD and test environments

# Enable Docker-based tests
# Used in: tests/conftest.py, tests/test_bioinformatics_tools/*
# DOCKER_TESTS=false

# Enable performance tests
# Used in: tests/conftest.py
# PERFORMANCE_TESTS=false

# Enable integration tests (enabled by default)
# Used in: tests/conftest.py
# INTEGRATION_TESTS=true

# Test security features (enabled by default)
# Used in: tests/utils/testcontainers/docker_helpers.py
# TEST_SECURITY_ENABLED=true

# CI environment detection
# Used in: tests/conftest.py
# CI=false

# ============================================================================
# Maintainer & CI/CD Only (Not needed by regular users)
# ============================================================================
# These are only used by project maintainers for publishing and automation

# Docker Hub credentials for publishing images
# Used in: scripts/publish_docker_images.py:11-17
# DOCKER_HUB_USERNAME=your-dockerhub-username
# DOCKER_HUB_REPO=deepcritical-bioinformatics
# DOCKER_TAG=latest

# GitHub API credentials for contributor updates
# Used in: scripts/update_contributors.py:166-169
# GITHUB_TOKEN=ghp_your_github_token_here
# REPO_OWNER=DeepCritical
# REPO_NAME=DeepCritical
